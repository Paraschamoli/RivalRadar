# ── Required ──────────────────────────────────────────────
# OpenRouter API key → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-

# Firecrawl API key → https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-

# ── Optional (if you want to swap search providers) ───────
# Tavily (better search results) → https://app.tavily.com/
TAVILY_API_KEY=tv

# Serper (Google search API) → https://serper.dev/
SERPER_API_KEY=

# ── LLM Provider Configuration ──────────────────────────────
# Provider selection: "openrouter" (default) or "bharatcode"
LLM_PROVIDER=openrouter

# BharatCode Configuration (only needed when LLM_PROVIDER=bharatcode)
# Get API key from https://bharatcode.ai/
BHARATCODE_API_KEY=
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1

# ── Optional Integrations ───────────────────────────────────
# Default true
ENABLE_GOOGLE_MAPS_SCRAPER=true